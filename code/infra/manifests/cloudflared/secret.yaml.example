# =============================================================================
# cloudflared Secret — EXAMPLE ONLY
# =============================================================================
#
# ⚠️  KHÔNG COMMIT FILE NÀY VỚI TOKEN THẬT!
#
# Cách sử dụng:
#   Option 1 — kubectl (nhanh nhất):
#     kubectl create secret generic cloudflared-token \
#       --namespace=cloudflare \
#       --from-literal=tunnel-token=<YOUR_TOKEN>
#
#   Option 2 — YAML + Sealed Secrets (GitOps-safe):
#     1. Copy file này → secret.yaml
#     2. Điền token thật
#     3. kubeseal < secret.yaml > sealed-secret.yaml
#     4. kubectl apply -f sealed-secret.yaml
#     5. XÓA secret.yaml (chứa plaintext token)
#
# Lấy tunnel token:
#   - Cloudflare Dashboard → Zero Trust → Networks → Tunnels
#   - Hoặc: cloudflared tunnel token <TUNNEL_NAME>
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: cloudflared-token
  namespace: cloudflare
type: Opaque
stringData:
  tunnel-token: "YOUR_CLOUDFLARE_TUNNEL_TOKEN_HERE"
