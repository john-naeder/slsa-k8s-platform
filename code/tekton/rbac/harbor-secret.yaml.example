# Harbor registry credentials for Tekton (Kaniko push)
# Create the actual secret with:
#   kubectl create secret docker-registry harbor-registry-credentials \
#     --namespace=tekton-pipelines \
#     --docker-server=harbor.kythuat.vn \
#     --docker-username=admin \
#     --docker-password=<harbor-admin-password>
#
# Or apply this template and fill in the base64–encoded dockerconfigjson:
apiVersion: v1
kind: Secret
metadata:
  name: harbor-registry-credentials
  namespace: tekton-pipelines
  annotations:
    tekton.dev/docker-0: https://harbor.kythuat.vn
type: kubernetes.io/dockerconfigjson
data:
  # Replace with: echo -n '{"auths":{"harbor.kythuat.vn":{"username":"admin","password":"<pw>"}}}' | base64
  .dockerconfigjson: REPLACE_ME
