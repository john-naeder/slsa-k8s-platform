# =============================================================================
# .env.example — Tham khảo tất cả secrets/config trong project
# =============================================================================
# File này KHÔNG dùng trực tiếp. Mỗi secret thuộc về 1 tool cụ thể:
#
#   Secret                  → Config ở đâu?
#   ───────────────────     ──────────────────────────────────────────
#   SSH user, keys          → infra/bootstrap/bootstrap.env
#   K8s node IPs, CIDRs    → infra/ansible/inventory/ (hosts.yml, network.yml)
#   Ansible vault secrets   → infra/ansible/.../vault.yml (encrypted)
#   Cloudflare tunnel token → kubectl create secret (1 lần, xem manifests/cloudflared/)
#   Harbor admin password   → Sealed Secret hoặc Helm values (Phase 3)
#   Let's Encrypt email     → infra/manifests/cluster-issuer.yaml
#
# ⚠️  KHÔNG điền giá trị thật vào file này — nó để tham khảo!
# =============================================================================

# --- Cloudflare Tunnel ---
# Dùng: kubectl create secret (xem infra/manifests/cloudflared/README.md)
CLOUDFLARE_TUNNEL_TOKEN="<tunnel-token-from-cloudflare-dashboard>"

# --- Domain ---
DOMAIN="your-domain.com"

# --- Kubernetes ---
K8S_MASTER_IP="100.x.x.x"
K8S_WORKER_IP="100.x.x.x"
K8S_POD_CIDR="10.244.0.0/16"
K8S_SERVICE_CIDR="10.95.0.0/12"

# --- Harbor Registry (Option A) ---
# Dùng: Sealed Secret hoặc Helm values
HARBOR_ADMIN_PASSWORD="<change-me>"
HARBOR_URL="harbor.your-domain.com"

# --- Kafka ---
KAFKA_BROKERS="kafka-cluster-kafka-bootstrap:9092"
KAFKA_TOPIC="demo-events"

# --- Let's Encrypt ---
# Dùng: Sửa trực tiếp trong infra/manifests/cluster-issuer.yaml
LETSENCRYPT_EMAIL="your-email@example.com"

# --- Ansible Vault ---
# Dùng: File .vault_password (gitignored)
ANSIBLE_VAULT_PASSWORD_FILE=".vault_password"
